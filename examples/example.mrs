fn main() -> i32 {
    let mut v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);

    let slc: &[i32] = &v;
    *slc[2isize]
}

fn print_i32(x: &i32) {
    printf("%d\n", *x);
}

fn printf(format: *c_char, ...) -> i32;
fn scanf(format: *c_char, ...) -> i32;

fn fac(n: i32) -> i32 {
    (1..=n).into_iter().prod()
}

fn make_linear(a: i32, b: i32) -> impl Fn(i32) -> i32 {
    |x| a * x + b
}

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn is_origin(&self) -> bool {
        self.x == 0 && self.y == 0
    }

    fn new(x: i32, y: i32) -> Self {
        Point { x, y }
    }
}

fn sum_slice(slice: &[i32]) -> i32 {
    slice.into_iter().map(|x| *x).sum()
}
