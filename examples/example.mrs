fn main() -> i32 {
    let p: *i32 = alloc_n::<i32>(3);
    *p = 10;
    *(p.offset(1)) = 20;
    *(p.offset(2)) = 30;

    let s: &[i32] = slice_from_raw_parts(p, 3);
    let n = slice_len(s);
    let a = *slice_at(s, 0);
    let b = *slice_at(s, 1);
    let c = *slice_at(s, 2);
    printf("len=%d a=%d b=%d c=%d\n", n as i32, a, b, c);

    x
}

fn print_i32(x: &i32) {
    printf("%d\n", *x);
}

fn printf(format: *c_char, ...) -> i32;
fn scanf(format: *c_char, ...) -> i32;

fn fac(n: i32) -> i32 {
    (1..=n).into_iter().prod()
}

fn make_linear(a: i32, b: i32) -> impl Fn(i32) -> i32 {
    |x| a * x + b
}

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn is_origin(&self) -> bool {
        self.x == 0 && self.y == 0
    }

    fn new(x: i32, y: i32) -> Self {
        Point { x, y }
    }
}

fn consume_slice(slice: &[i32]) {}
