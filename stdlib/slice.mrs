fn slice_from_raw_parts<T>(ptr: *T, len: isize) -> &[T];
fn slice_len<T>(s: &[T]) -> isize;
fn slice_at<T>(s: &[T], index: isize) -> &T;

impl<T> [T] {
    fn len(&self) -> isize {
        slice_len(self)
    }

    fn at(&self, index: isize) -> &T {
        if index < 0isize || index >= self.len() {
            panic("slice index out of bounds\n");
        }
        slice_at(self, index)
    }
}

impl<T> Index<isize> for [T] {
    type Output = T;

    fn index(&self, index: isize) -> &T {
        self.at(index)
    }
}

struct SliceIter<T> {
    slice: &[T],
    idx: isize,
}

impl<T> IntoIterator for &[T] {
    type Item = &T;
    type IntoIter = SliceIter<T>;

    fn into_iter(self) -> SliceIter<T> {
        SliceIter { slice: self, idx: 0isize }
    }
}

impl<T> Iterator for SliceIter<T> {
    type Item = &T;

    fn next(&mut self) -> Option<&T> {
        if self.idx >= slice_len(self.slice) {
            Option::None
        } else {
            let item = slice_at(self.slice, self.idx);
            self.idx = self.idx + 1isize;
            Option::Some { item }
        }
    }
}
